# Docker Compose 环境变量 — 复制此文件为 .env 后填入真实值

# 后端数据库（SQLite 在容器内使用挂载卷）
DATABASE_URL=sqlite+aiosqlite:///./act2.db

# JWT 签名密钥 — 至少 32 字符
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<在此填入随机密钥>

# Agent API 配置（Mode 2 评估用）
AGENT_API_KEY=<在此填入 API Key>
AGENT_BASE_URL=https://api.deepseek.com/anthropic
AGENT_MODEL=deepseek-v4-pro

# 代理地址
PROXY_URL=http://127.0.0.1:8001/proxy

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 运行环境: development, production
ENVIRONMENT=production

# CORS（生产环境改为实际域名）
CORS_ORIGINS=http://localhost:3000
